":160,"west_africa_gap":240,"note":"No public, dated series of physical cocoa differentials (Ivory Coast, Ghana, Ecuador, Nigeria vs London/NY) was found; ICCO's daily price is an average of London and New York futures, not a differential, and farmgate prices are not differentials. Only the fixed Living Income Differential on Ivorian and Ghanaian forward sales is a public physical premium.","confidence":"low"},"rules":{"source":"https://www.ice.com/publicdocs/rulebooks/futures_us/9_Cocoa.pdf","read_on":"2026-11-17","premiums":{"A":160,"B":80,"C":0},"groups":{"A":["Ghana","Ivory Coast","Nigeria","Sierra Leone","Togo"],"B":["Arriba (Ecuador)","Ecuador","Brazil","Cameroon","Colombia","Costa Rica","Sanchez","Hispaniolas","Honduras","Jamaica","Indonesia-Java","Mexico","Peru","Venezuela","Tanzania","Uganda","Papua New Guinea","New Guinea","Nicaragua","Panama","Madagascar","Solomon Island","Vanuatu","Suriname"],"C":["Bolivia","Haiti","Indonesia-Sulawesi","Indonesia","Malaysia","all other growths"]},"count_classes":{"A":[1000,1200],"B":[1100,1300],"C":[1200,1400]},"count_disc_pct":[[1,25,0.5],[26,50,1.0],[51,75,1.5],[76,100,2.0],[101,125,2.5],[126,150,3.0],[151,175,3.5],[176,200,4.0]],"slate":{"standard_pct":10,"usd_t_per_pct":2.2,"exempt":["Indonesia-Sulawesi","Sanchez","Haiti"]},"defects":{"mould_pct":4,"insect_pct":4,"combined_pct":6,"note":"over these limits not deliverable; smoky or hammy cocoa not deliverable"},"waste":{"par_pct":1.0,"max_pct":5.0,"note":"1.01-2.50%: deduction = waste - 1.0; 2.51-5.00%: 1.5 + 1.5 x (waste - 2.5); deducted from invoice weight"},"certificate_validity":"Rule 9.18(d)(ii)(1): a Certificate of Grade issued during a delivery period is valid for the rest of that period and the next one; issued outside a delivery period, for the next two delivery periods. Rule 9.18(d)(ii)(2): for redelivery, growth, description, condition, waste and count stay valid indefinitely while the lot is identifiable, but Grade only for the initial delivery month and the next delivery period (bags in good condition). Rule 9.18(c)(i): when Grade validity lapses the deliverer may have the cocoa completely or partially regraded; cocoa that failed Rule 9.18(b) cannot be regraded. There is no fixed one-year expiry.","grade_validity_rule":{"rule":"9.18(d)(ii)(1)-(2), 9.18(c)(i)","in_delivery_period":"rest of that period + next delivery period","outside":"next two delivery periods","redelivery_grade":"initial delivery month + next delivery period","regrade":"allowed after lapse (full or partial); not for cocoa that failed","delivery_period_assumption":"taken as the delivery month (Mar, May, Jul, Sep, Dec); the rulebook does not define the term"},"weight_loss_allowance":"Rule 9.23(b)(i)-(ii): weights count as true only if weighed within 13 full business days before delivery; otherwise (and on redelivery) a loss-of-weight allowance applies: 0.25% per 30 calendar days or part from the Weight Return Date (Rule 9.23(b)(ii)(B)); Sanchez, Haiti, Jamaica tiered by arrival (1% / 2% in the first 30 / 60 days if arrived under 40 days before weighing, then +0.25% per 30 days) (Rule 9.23(b)(ii)(A)). Moving the cocoa voids the weights (9.23(f)(i)).","weight":{"franchise_pct":1,"partial_default_t":[9.5,9.9],"max_invoiced_t":10.3,"bag_kg":[45,75]},"customs":"Resolution No. 1 (Apr 8 2025): cocoa submitted for grading must be customs cleared and free of duties, taxes and tariffs","eudr":"None in the ICE Futures U.S. cocoa rules (US warehouses). ICE Futures Europe (London cocoa) has its own EUDR delivery rules; not modelled here.","port_note":"Rule 9.02(c): no price differential by delivery point; seller chooses","load_out":"Resolution No. 2 XI: 250 t/day (operator holding up to 30,000 t at a port) or 500 t/day; 60 days","changes":[{"effective_date":"2010-05-20","first_contract":"all","rule_area":"Growths (Rule 9.18 b(i))","short":"CCN-51 Ecuador in Group B","old":"CCN-51 not deliverable","new":"CCN-51 (Ecuador) added to Group B (+$80)","plain_english":"The high-yield CCN-51 Ecuadorian bean becomes deliverable at the $80 premium; Ecuador later becomes the largest certified origin.","source_url":"https://www.ice.com/publicdocs/rulebooks/futures_us/9_Cocoa.pdf","source_note":"Rulebook amendment note May 20 2010"},{"effective_date":"2015-05-01","first_contract":"all","rule_area":"Load-out (Resolution 2 XI)","short":"Minimum load-out","old":"none","new":"250 t/day (up to 30,000 t held) or 500 t/day; load-out within 60 days","plain_english":"Warehouses must ship certified cocoa at a minimum daily pace.","source_url":"https://www.ice.com/publicdocs/rulebooks/futures_us/9_Cocoa.pdf","source_note":"Resolution No. 2 XI adopted Dec 5 2014, eff. May 1 2015"},{"effective_date":"2015-12-30","first_contract":"all","rule_area":"Growths (Rule 9.18 c(i))","short":"CCN renamed Ecuador","old":"CCN","new":"Ecuador","plain_english":"Name change only.","source_url":"https://www.ice.com/publicdocs/rulebooks/futures_us/9_Cocoa.pdf","source_note":"Rulebook amendment note Dec 4 2015"},{"effective_date":"2020-01-30","first_contract":"Mar 2020","rule_area":"Growths (Rule 9.18 b(i))","short":"Groups modernised","old":"Main Crop designations; Tanzania, Uganda, Para (Brazil) in Group C","new":"Main/Mid/Light crop labels removed; Tanzania, Uganda, Para to Group B (+$80); Lome renamed Togo","plain_english":"Removes crop-timing labels; three origins gain $80/t.","source_url":"https://cftc.gov/filings/ptc/ptc011420iceusdcm001.pdf","source_note":"ICE Submission 20-10 (Jan 14 2020), eff. Jan 30 2020 for all months from March 2020"},{"effective_date":"2020-04-01","first_contract":"May 2020","rule_area":"Grading (Rule 9.18 b(iii))","short":"Class set by count","old":"group named on the sample order; over-count lots rejected","new":"class (premium group) set by the bean count found at grading; over 1,400 beans/kg not deliverable","plain_english":"Fewer rejections: a West African lot with too high a count is certified at the Group B or C premium instead of failing.","source_url":"https://cftc.gov/filings/ptc/ptc011420iceusdcm001.pdf","source_note":"ICE Submission 20-10, eff. Apr 1 2020, from the May 2020 contract"},{"effective_date":"2020-10-01","first_contract":"physical","rule_area":"Physical market","short":"Living Income Differential","old":"none","new":"$400/t premium on Ivory Coast and Ghana forward sales","plain_english":"Not an exchange rule: West African beans cost $400/t more physically, but ICE pays only +$160 for Group A, so they are rarely delivered.","source_url":"https://uk.investing.com/news/commodities-news/cocoa-set-for-bumpy-ride-as-africa-premium-disrupts-futures-2038896","source_note":"Bloomberg via Investing.com, 27 Jan 2020"},{"effective_date":"2024-10-01","first_contract":"all","rule_area":"Bags (Rule 9.07 b)","short":"Bag weight 45-75 kg","old":"bags of the weight customary for the growth","new":"bags 45-75 kg for all growths; 'Chop' defined","plain_english":"Clear bag-weight standard; no change in value (ICE).","source_url":"https://cftc.gov/filings/orgrules/rules0913246059.pdf","source_note":"ICE Submission 24-137 (Sep 13 2024); rulebook notes: amended Jun 20 2024, eff. Oct 1 2024"},{"effective_date":"2025-04-08","first_contract":"all","rule_area":"Customs (Resolution 1)","short":"Duty paid","old":"silent","new":"cocoa for grading must be customs cleared and free of duties, taxes and tariffs","plain_english":"Any US tariff on an origin is paid before the cocoa can be certified.","source_url":"https://www.ice.com/publicdocs/rulebooks/futures_us/9_Cocoa.pdf","source_note":"Resolution No. 1 adopted Apr 8 2025, eff. Apr 8 2025"},{"effective_date":"2026-04-24","first_contract":"all","rule_area":"Weight defaults (Rule 9.07 f(ii), 9.11)","short":"Weight default rules","old":"","new":"10 t \u00b11%; 9.5-9.9 t partial default (higher of $11/t or 5% of price on the shortfall); over 10.3 t invoiced at 10.3 t; pro forma at 90% without weight note","plain_english":"Tighter penalties for short-weight lots.","source_url":"https://www.ice.com/publicdocs/rulebooks/futures_us/9_Cocoa.pdf","source_note":"Rulebook amendment note: amended Jun 20 2024, eff. Apr 24 2026"}]},"variables":["ICE daily cocoa certified stock by origin, growth group and port (from Oct 2026)","ICE monthly grading results by port, origin and class: tonnes, group premium, weight (count and waste) discount, slate discount, initial vs regrade (2016 on)","ICE Cocoa rulebook: group premiums, count classes, slate, waste and weight rules, certificate validity","CC settlements by contract (2004 on) and daily front/second spreads","Living Income Differential (C\u00f4te d'Ivoire, Ghana)"],"checks":{"rows_bags":970491.0,"certified_bags":970491.0,"age_t":65130.0,"stock_t":65130.0}}